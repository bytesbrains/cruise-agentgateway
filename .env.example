# Copy to .env (gitignored) and fill in. Never commit a real key.

# A Cruise API key. The free demo takes a cru_demo_ key and costs nothing to run;
# a production key starts cru_ and spends real money.
CRUISE_API_KEY=cru_demo_replace_me

# Which Cruise to talk to. The demo returns emulated completions with the real
# response shape and headers. The default demo project never accumulates spend.
CRUISE_BASE_URL=https://cruise-demo.bytesbrains.net/v1

# Production instead:
# CRUISE_BASE_URL=https://cruise.bytesbrains.net/v1

# Optional: your own hard-cap key from the dashboard's Demo tab, "See the hard cap".
# Used only by ./smoke.sh --budget-cap. Keep CRUISE_API_KEY as the normal demo key.
# This separate project charges emulated $0.002/call against $0.01/minute; no real spend.
CRUISE_DEMO_CAP_API_KEY=
